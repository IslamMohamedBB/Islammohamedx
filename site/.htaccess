# CTRL Solutions — ctrlsolutions-eg.com
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# force HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://ctrlsolutions-eg.com/$1 [R=301,L]
# short links for bios
RewriteRule ^ceo/?$ /islam-mohamed/ [R=301,L]
RewriteRule ^islam/?$ /islam-mohamed/ [R=301,L]
RewriteRule ^ar/ceo/?$ /ar/islam-mohamed/ [R=301,L]
RewriteRule ^articles/?$ /blog/ [R=301,L]
RewriteRule ^ar/articles/?$ /ar/blog/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(html|xml)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
<FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|ico|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddDefaultCharset utf-8
